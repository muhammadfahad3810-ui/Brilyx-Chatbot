APP_NAME=Brilyx Chatbot
ENVIRONMENT=development
# Local development default — SQLite, no setup required. In production
# (e.g. Render), set this to a managed PostgreSQL connection string
# instead; a bare "postgres://" URL is automatically normalized to
# "postgresql://" (see backend/app/database.py and
# docs/deployment-render.md "Database").
DATABASE_URL=sqlite:///./data/brilyx.db

# AI provider: "ollama" (local, free, default — recommended for
# development), "gemini", or "groq" (both cloud, for production). See
# docs/ai-engine.md.
AI_PROVIDER=ollama

# Ollama (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_TIMEOUT_SECONDS=60

# Gemini (used only when AI_PROVIDER=gemini — leave blank otherwise).
# NEVER put a real API key here or in any committed file; set it in your
# actual (git-ignored) .env or your hosting platform's environment
# variable settings instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=60

# Groq (used only when AI_PROVIDER=groq — leave blank otherwise).
# NEVER put a real API key here or in any committed file; set it in your
# actual (git-ignored) .env or your hosting platform's environment
# variable settings instead.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60
# Caps the main chat reply's length. Groq enforces a tokens-per-minute
# limit that includes a reserved output budget when this is left unset —
# capping it keeps normal requests comfortably under that limit. See
# docs/ai-engine.md "Groq TPM limit" for the full explanation.
GROQ_MAX_TOKENS=800
# Structured lead-extraction (see docs/conversation-intelligence.md) uses
# its own, smaller/cheaper model — keeps its token usage from competing
# with the main chat call's tokens-per-minute budget.
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
# GROQ_EXTRACTION_MODEL is a reasoning model — Groq counts its hidden
# reasoning tokens against this limit before any visible JSON is produced,
# so this must stay well above the visible schema's own size (verified
# live: 1200 reliably leaves room for both; ~300 was measured to silently
# truncate to an empty response every time).
GROQ_EXTRACTION_MAX_TOKENS=1200

# Conversation/chat behavior
CHAT_HISTORY_MAX_MESSAGES=20
CHAT_MAX_MESSAGE_LENGTH=4000

# Phase 7: browser origins allowed to call this API (comma-separated).
# Add the real www.brilyx.com origin(s) here in production.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080

# Phase 8: owner notifications (high-value lead / demo request / human
# handoff). Two transports are supported; leave both unset to keep
# notifications disabled — the app remains fully usable either way, only
# the notification step is skipped (see docs/business-actions.md).
# NEVER commit real credentials/keys here — this file only documents the
# variable names.

# Preferred in production: Resend, over plain HTTPS (works from Render,
# which cannot reach smtp.gmail.com:587 — outbound SMTP is blocked/
# unroutable there). Used automatically instead of SMTP below whenever
# RESEND_API_KEY, RESEND_FROM_EMAIL, and OWNER_NOTIFICATION_EMAIL are all
# set. RESEND_FROM_EMAIL must be a sender address/domain verified in your
# Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Fallback transport: standard authenticated SMTP. Only used when Resend
# above is not fully configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# If using Gmail: this must be a 16-character Google "App Password", not
# your normal account password. Gmail rejects normal-password SMTP login;
# see docs/business-actions.md for setup notes. Note: Gmail SMTP is not
# reachable from Render at all (see above) — use Resend there instead.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Recipient for both transports above.
OWNER_NOTIFICATION_EMAIL=

# Off by default — every lead creation would otherwise email the owner,
# which is noisy. The important notifications (high-value lead, demo
# request, human handoff) are always on once Resend or SMTP is configured
# above.
NOTIFY_ON_LEAD_CREATED=false
